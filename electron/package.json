{
  "name": "hackertube-desktop",
  "version": "1.0.10",
  "private": true,
  "description": "Frameless Electron desktop app for HackerTube",
  "author": "PanDuroDev",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:backend": "node scripts/build-backend.js",
    "dist": "npm run build:backend && electron-builder",
    "dist:win": "npm run build:backend && electron-builder --win portable",
    "dist:mac": "npm run build:backend && electron-builder --mac",
    "dist:linux": "npm run build:backend && electron-builder --linux",
    "dir:win": "npm run build:backend && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pandurodev.hackertube",
    "productName": "HackerTube",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "backend-bin",
        "to": "backend"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "update.js",
      "install-fs.js",
      "installer.js",
      "installer.html",
      "installer.css",
      "installer-ui.js",
      "installer-preload.js",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "HackerTube-win-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "HackerTube-mac-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "HackerTube-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ]
    },
    "portable": {
      "artifactName": "HackerTube-win-${arch}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
